# TeamOps environment variables
#
# The web app talks to the TeamOps API server, which owns the SQLite database.
# In development, Vite proxies /api to the server on port 3001, so no URL is
# needed here. In production, set API_BASE_URL if the API is served from a
# different origin than the frontend.

# API_BASE_URL=http://localhost:3001

# Optional: where the SQLite database file lives (server-side only).
# Defaults to server/data/teamops.db. Use a persistent volume in production.
# TEAMOPS_DB_PATH=/var/lib/teamops/teamops.db

# Port for the API server (server-side only). Defaults to 3001.
# PORT=3001

# Optional Supabase configuration for a future migration. Not used by the
# current SQLite-backed API.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
